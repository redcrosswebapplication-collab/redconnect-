# Copy to .env. Get these values from Supabase Project Settings > API.
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-client-key
# Server-only secret. Never put this in the Flutter app or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
